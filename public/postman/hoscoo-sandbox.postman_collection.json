{
  "info": {
    "name": "Hoscoo Sandbox",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "hoscoo_test_key",
      "value": "hsc_test_your_key_here"
    }
  ],
  "item": [
    {
      "name": "Initiate a payment instruction (sandbox)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{hoscoo_test_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "https://sandbox-api.hoscoo.com/v1/sandbox/payments",
          "host": [
            "https://sandbox-api.hoscoo.com"
          ],
          "path": [
            "v1",
            "sandbox",
            "payments"
          ]
        }
      }
    },
    {
      "name": "Get sandbox payment lifecycle status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{hoscoo_test_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "https://sandbox-api.hoscoo.com/v1/sandbox/payments",
          "host": [
            "https://sandbox-api.hoscoo.com"
          ],
          "path": [
            "v1",
            "sandbox",
            "payments"
          ]
        }
      }
    },
    {
      "name": "Issue a deterministic sandbox FX quote",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{hoscoo_test_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "https://sandbox-api.hoscoo.com/v1/sandbox/fx-quote",
          "host": [
            "https://sandbox-api.hoscoo.com"
          ],
          "path": [
            "v1",
            "sandbox",
            "fx-quote"
          ]
        }
      }
    },
    {
      "name": "Refresh (re-fetch) a previously issued quote",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{hoscoo_test_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "https://sandbox-api.hoscoo.com/v1/sandbox/fx-quote",
          "host": [
            "https://sandbox-api.hoscoo.com"
          ],
          "path": [
            "v1",
            "sandbox",
            "fx-quote"
          ]
        }
      }
    },
    {
      "name": "Issue a fresh, cryptographically random hsc_test_ key",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{hoscoo_test_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "https://sandbox-api.hoscoo.com/v1/sandbox/keys",
          "host": [
            "https://sandbox-api.hoscoo.com"
          ],
          "path": [
            "v1",
            "sandbox",
            "keys"
          ]
        }
      }
    },
    {
      "name": "Resolve a pending 3-DS/step-up challenge",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{hoscoo_test_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
