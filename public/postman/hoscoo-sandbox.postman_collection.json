          "host": [
            "https://sandbox-api.hoscoo.com"
          ],
          "path": [
            "v1",
            "sandbox",
            "simulate"
          ]
        }
      }
    },
    {
      "name": "Clear all simulation rules for this API key",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{hoscoo_test_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "https://sandbox-api.hoscoo.com/v1/sandbox/simulate",
          "host": [
            "https://sandbox-api.hoscoo.com"
          ],
          "path": [
            "v1",
            "sandbox",
            "simulate"
          ]
        }
      }
    },
    {
