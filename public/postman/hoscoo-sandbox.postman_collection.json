          "host": [
            "https://sandbox-api.hoscoo.com"
          ],
          "path": [
            "v1",
            "sandbox",
            "payments",
            "challenge"
          ]
        }
      }
    },
    {
      "name": "Register a programmable simulation rule",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{hoscoo_test_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "https://sandbox-api.hoscoo.com/v1/sandbox/simulate",
          "host": [
            "https://sandbox-api.hoscoo.com"
          ],
          "path": [
            "v1",
            "sandbox",
            "simulate"
          ]
        }
      }
    },
