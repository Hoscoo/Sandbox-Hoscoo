        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{hoscoo_test_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "https://sandbox-api.hoscoo.com/v1/sandbox/reset",
