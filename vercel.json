{
  "rewrites": [
    {
      "source": "/v1/:path*",
      "has": [{ "type": "host", "value": "sandbox-api.hoscoo.com" }],
      "destination": "/api/v1/sandbox/:path*"
    },
    {
      "source": "/openapi/:path*",
      "has": [{ "type": "host", "value": "sandbox-api.hoscoo.com" }],
      "destination": "/openapi/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/openapi/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, s-maxage=300, stale-while-revalidate=60" }]
    }
  ],
  "crons": [
    {
      "path": "/api/v1/sandbox/webhooks/dispatch",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/webhooks/dispatch",
      "schedule": "0 0 * * *"
    }
  ]
}
